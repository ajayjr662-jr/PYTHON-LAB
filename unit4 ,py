try:
    with open("data.txt", "r") as f:
        error_count = 0
        print("----- LOG FILE CONTENTS -----")
        for line in f:
            print(line.strip())

            if "ERROR" in line:
                error_count += 1
        print("----- ERROR SUMMARY -----")
        print("Total ERROR messages:", error_count)

except FileNotFoundError:
    print("Error: The data file does not exist.")