import json

try:
    # Open and read the JSON file
    with open("logs.json", "r") as file:
        logs = json.load(file)

    info_count = 0
    warning_count = 0
    error_count = 0

    print("APPLICATION LOG DETAILS")
    print("-----------------------")

    # Display all log records
    for log in logs:
        print("Timestamp:", log["timestamp"])
        print("Level:", log["level"])
        print("Message:", log["message"])
        print("-----------------------")

        # Count log levels
        if log["level"] == "INFO":
            info_count += 1
        elif log["level"] == "WARNING":
            warning_count += 1
        elif log["level"] == "ERROR":
            error_count += 1

    # Display total counts
    print("\nLOG SUMMARY")
    print("INFO messages:", info_count)
    print("WARNING messages:", warning_count)
    print("ERROR messages:", error_count)
    print("Total logs:", len(logs))

except FileNotFoundError:
    print("Error: logs.json file not found!")

except json.JSONDecodeError:
    print("Error: Invalid JSON file!")

except KeyError as e:
    print("Missing field:", e)